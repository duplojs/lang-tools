{
  "name": "@duplojs/lang-tools",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "DuploJS",
    "url": "https://github.com/duplojs"
  },
  "description": "Tools and utilities for @duplojs/lang.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duplojs/lang-tools.git"
  },
  "scripts": {
    "build": "./.commands/build.sh",
    "test:integration": "npm run build && npm --workspace integrations run test",
    "test:ut": "./.commands/test-ut.sh",
    "test:ut:watch": "./.commands/test-ut.sh --watch",
    "test:ut:update": "./.commands/test-ut.sh --update",
    "test:types": "./.commands/test-types.sh",
    "test:types:target": "./.commands/test-types-target.sh",
    "test:lint": "./.commands/test-lint.sh",
    "test:lint:fix": "./.commands/test-lint.sh --fix",
    "prepare": "husky"
  },
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./toTypescript": {
      "import": "./dist/toTypescript/index.mjs",
      "require": "./dist/toTypescript/index.cjs",
      "types": "./dist/toTypescript/index.d.ts"
    },
    "./typescript": {
      "import": "./dist/typescript/index.mjs",
      "require": "./dist/typescript/index.cjs",
      "types": "./dist/typescript/index.d.ts"
    }
  },
  "peerDependencies": {
    "@duplojs/lang": "0.0.1-beta.2"
  },
  "dependencies": {
    "@typescript/typescript6": "6.0.2"
  },
  "devDependencies": {
    "@duplojs/code-config": "0.1.0",
    "@types/node": "24.1.0",
    "husky": "9.1.7",
    "rolldown": "1.2.4",
    "unplugin-dts": "1.0.3",
    "@typescript/typescript6": "6.0.2",
    "tslib": "2.8.1",
    "tsx": "4.23.12",
    "tscw-config": "1.1.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "@vitest/coverage-istanbul": "4.1.10"
  },
  "workspaces": ["integrations"],
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "duplojs",
    "duplojs-lang",
    "lang-tools",
    "tools",
    "tooling",
    "transformer",
    "typescript",
    "json-schema",
    "openapi"
  ],
  "engines": {
    "node": ">=24.18.0"
  }
}
